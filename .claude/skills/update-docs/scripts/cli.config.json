{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true
    },
    "contextOptions": {
      "viewport": { "width": 1440, "height": 900 },
      "ignoreHTTPSErrors": true,
      "locale": "en-US",
      "timezoneId": "Asia/Kolkata"
    }
  },
  "outputDir": ".playwright-cli",
  "timeouts": {
    "action": 10000,
    "navigation": 60000
  }
}
